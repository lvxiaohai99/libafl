# libafl Doxygen 配置（Doxygen 1.8+）
# 生成命令：doxygen Doxyfile （或 ./build.sh --doc）
# 输出目录：docs/html

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "libafl"
PROJECT_NUMBER         = 1.1.0
PROJECT_BRIEF          = "Application Foundation Library - 通用 C++11 工具库"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES

INPUT                  = afl README.md
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h *.cpp
RECURSIVE              = YES
EXCLUDE_SYMBOLS        = detail

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

OUTPUT_LANGUAGE        = Chinese
USE_WINDOWS_ENCODING   = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES

GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = AFL_ENABLE_SSL=1

QUIET                  = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
JAVADOC_AUTOBRIEF      = YES
SORT_MEMBER_DOCS       = NO
SHOW_DIRECTORIES       = YES
